<?xml version="1.0" encoding="utf-8"?>
<!--
    DormDesk Auto Backup Rules (Android 11 and below)
    Prevents sensitive user data from being included in Auto Backup.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?>
<!--
    DormDesk Data Extraction Rules (Android 12+)
    Defines which data is included in device-to-device transfers and cloud backups.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Do NOT back up sensitive user data -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Allow preferences to transfer between devices -->
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>

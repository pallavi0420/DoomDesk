# DormDesk AI Backend Environment Configuration
# Copy this file to .env and insert your Google Gemini API Key

# Google Gemini API Key (Obtain from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model (e.g. gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# Server Port
PORT=8000

# DormDesk AI Backend Environment Configuration
# Copy this file to .env and insert your Groq API Key

# Groq API Key (Obtain from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM Model (e.g. llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768)
GROQ_MODEL=llama-3.3-70b-versatile

# Server Port
PORT=8000

# DormDesk AI Backend Environment Configuration
# Copy this file to .env and insert your API Key

# xAI Grok API Key (Obtain from https://console.x.ai/)
GROK_API_KEY=your_grok_api_key_here

# Grok Model (e.g. grok-2-latest, grok-beta)
GROK_MODEL=grok-2-latest

# (Optional fallback) Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Server Port
PORT=8000
